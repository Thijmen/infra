# Copy to .env (gitignored) or load with `op run --env-file=.env.example`.
# None of these values belong in git.

# Cloudflare API token for the provider (Access: Apps and Policies Edit,
# Access: Organizations Read, Cloudflare Tunnel Edit, Zero Trust Edit,
# Zone Read, DNS Edit on thijmen.cloud, Transform Rules Edit, Zone WAF Edit
# on every zone in wafZones).
CLOUDFLARE_API_TOKEN=

# R2 API token scoped to the pulumi-state bucket (Object Read & Write).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# R2 rejects the checksums newer AWS SDKs send by default.
AWS_REQUEST_CHECKSUM_CALCULATION=when_required
AWS_RESPONSE_CHECKSUM_VALIDATION=when_required

# Encrypts secret values in the state. Keep a copy in your password manager.
PULUMI_CONFIG_PASSPHRASE=

# Comma-separated CIDRs that skip Cloudflare Access on the EmDash MCP paths.
TRUSTED_IPS=203.0.113.7/32

# Comma-separated emails allowed through Access to T3 Code (t3Host).
T3_ACCESS_EMAILS=you@example.com
